# Lumen API Configuration Example
PORT=8000
LUMEN_DEMO_KEY=lmn_demo0000000000000000000000000000
LUMEN_ADMIN_KEY=your_secure_admin_key_here
LUMEN_WEBHOOK_SECRET=your_secure_webhook_secret_here
LUMEN_CORS_ORIGINS=https://lumen-frontend-production-06e5.up.railway.app
GAME_API_KEY=your_virtuals_game_api_key_here
LUMEN_FORCE_HTTPS=true
LUMEN_RATE_LIMIT=120
# Fail-closed posture for demos: memory endpoints 503 without Sibyl events.
# Default off (empty memory serves blind-but-200). Demo: --hard sets it.
LUMEN_REQUIRE_MEMORY=false
# Neon (Lakebase Postgres). Pooled URL for app traffic, direct URL for migrations.
# Copy from Neon dashboard or run `neon env pull`. Never commit real values.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
